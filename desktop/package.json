{
  "name": "mcbcode-studio-desktop",
  "version": "0.1.0",
  "description": "desktop version of mcbCode Studio",
  "author": "mcbCode",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mcbcode.studio",
    "productName": "mcbCode Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "web/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
